{
  "version": 1,
  "sdk_version": "0.26.3",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pnqvokaaggbyiwlnkiwb.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "harmony-hub",
      "version": "0.1.0",
      "title": "Harmony Hub"
    },
    "tools": [
      {
        "name": "get_business",
        "title": "Get business profile",
        "description": "Get the signed-in owner's business profile: name, website, country, currency, timezone, categories, team size, service locations and setup progress.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_business",
        "title": "Update business profile",
        "description": "Update editable details of the signed-in owner's business (name, website, timezone, team size). Only the provided fields change.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "description": "Business display name.",
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "website": {
              "description": "Business website URL.",
              "type": "string",
              "maxLength": 300
            },
            "timezone": {
              "description": "IANA timezone, e.g. Africa/Lagos.",
              "type": "string",
              "maxLength": 80
            },
            "team_size": {
              "description": "Team size bucket, e.g. 'independent' or '2-5'.",
              "type": "string",
              "maxLength": 40
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_employees",
        "title": "List team members",
        "description": "List the team members (employees) of the signed-in owner's business.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "add_employee",
        "title": "Add team member",
        "description": "Add a team member (employee) to the signed-in owner's business.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Team member's first name."
            },
            "last_name": {
              "description": "Team member's last name.",
              "type": "string",
              "maxLength": 80
            },
            "email": {
              "description": "Work email address.",
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "phone": {
              "description": "Phone number in international format.",
              "type": "string",
              "maxLength": 40
            },
            "job_title": {
              "description": "Role or job title, e.g. Stylist.",
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "first_name"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
